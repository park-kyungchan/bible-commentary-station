{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SubagentTypedExegesisContract",
  "description": "Typed JSON schema contract for theological and architectural subagents",
  "type": "object",
  "required": ["task_id", "verse_coordinates", "exegesis_results", "cross_references", "verification"],
  "properties": {
    "task_id": { "type": "string" },
    "verse_coordinates": {
      "type": "object",
      "required": ["book_id", "book_name", "chapter", "verse", "verse_id"],
      "properties": {
        "book_id": { "type": "integer", "minimum": 1, "maximum": 66 },
        "book_name": { "type": "string" },
        "chapter": { "type": "integer" },
        "verse": { "type": "integer" },
        "verse_id": { "type": "integer" }
      }
    },
    "exegesis_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_code", "title", "content_markdown", "practical_points"],
        "properties": {
          "source_code": {
            "type": "string",
            "enum": ["OXFORD", "WESLEY", "HOKMA", "GRAND", "CHARISMA", "MATTHEW_HENRY", "BAKER", "ESV_EXPOSITORY"]
          },
          "title": { "type": "string" },
          "content_markdown": { "type": "string" },
          "practical_points": { "type": "string" }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to_ref", "full_korean_text", "relationship_type", "theological_synthesis"],
        "properties": {
          "to_ref": { "type": "string" },
          "full_korean_text": { "type": "string" },
          "relationship_type": { "type": "string" },
          "theological_synthesis": { "type": "string" }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["has_denominational_bias", "hebrew_greek_validated", "is_ready_for_pulpit"],
      "properties": {
        "has_denominational_bias": { "type": "boolean" },
        "hebrew_greek_validated": { "type": "boolean" },
        "is_ready_for_pulpit": { "type": "boolean" }
      }
    }
  }
}
