[
  {
    "id": "apostles-creed-ecumenical",
    "title": "사도신경 (새 번역)",
    "variant": "ecumenical",
    "category": "creed",
    "citation": "한국기독교교회협의회 · 대한예수교장로회 공동 새 번역",
    "slides": [
      {
        "heading": "사도신경 (1/5)",
        "lines": [
          "나는 전능하신 아버지 하나님,",
          "천지의 창조주를 믿습니다.",
          "나는 그의 유일하신 아들,",
          "우리 주 예수 그리스도를 믿습니다."
        ]
      },
      {
        "heading": "사도신경 (2/5)",
        "lines": [
          "그는 성령으로 잉태되어",
          "동정녀 마리아에게서 나시고,",
          "본디오 빌라도에게 고난을 받아",
          "십자가에 못박혀 죽으시고,"
        ]
      },
      {
        "heading": "사도신경 (3/5)",
        "lines": [
          "장사된 지 사흘 만에 죽은 자",
          "가운데서 다시 살아나셨으며,",
          "하늘에 오르시어 전능하신 아버지",
          "하나님 우편에 앉아 계시다가,"
        ]
      },
      {
        "heading": "사도신경 (4/5)",
        "lines": [
          "거기로부터 살아 있는 자와 죽은 자를",
          "심판하러 오십니다.",
          "나는 성령을 믿으며 거룩한 공교회와",
          "성도의 교제와 죄를 용서받는 것과"
        ]
      },
      {
        "heading": "사도신경 (5/5)",
        "lines": [
          "몸의 부활과 영생을 믿습니다.",
          "아멘."
        ]
      }
    ]
  },
  {
